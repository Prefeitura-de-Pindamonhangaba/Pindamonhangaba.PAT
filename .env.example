COMPOSE_PROFILES=development
APP_URL=http://localhost:3000
ALLOW_LOCAL_HTTP=true
APP_PORT=3000
APP_BIND_ADDRESS=127.0.0.1
NEXT_BUILD_CPUS=2

# Para Bun fora do Compose ou para PostgreSQL externo
DATABASE_URL=
# Para PostgreSQL local via Compose
POSTGRES_USER=pat
POSTGRES_PASSWORD=
POSTGRES_DB=pat

KEYCLOAK_ENABLED=false
# Acesso direto à gestão com bun run dev e aplicação e banco em loopback
DEV_SKIP_AUTH=false
KEYCLOAK_ISSUER=https://sso.pindamonhangaba.sp.gov.br/realms/pindamonhangaba
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
